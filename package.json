{
  "name": "ussd_smart_payment_solution",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/MandelaMan/ussd_smart_payment_solution.git",
  "author": "MandelaMan <nelsonomoro@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "db:migrate": "node api/config/migrate.js",
    "db:status": "node api/config/migrate.js --status",
    "db:seed": "node scripts/seed-admin.js",
    "db:seed-dummy": "node scripts/seed-dummy-data.js",
    "db:backfill-activity": "node scripts/backfill-activity.js",
    "db:import-logs": "node scripts/import-logs-to-mysql.js",
    "build:admin": "cd admin && npm install && npm run build",
    "build": "yarn build:admin",
    "dev:admin": "cd admin && yarn dev",
    "xtream:sync": "node jobs/xtreamSyncJob.js --sync",
    "xtream:test": "node jobs/xtreamSyncJob.js --test-endpoints",
    "xtream:check": "node scripts/xtream-panel-check.js",
    "xtream:daily": "node jobs/xtreamDailyScheduler.js",
    "xtream:daily:once": "node jobs/xtreamDailyScheduler.js --once",
    "test:smoke": "node scripts/smoke-test.js",
    "test:xtream-spec": "node scripts/xtream-spec-test.js",
    "paybill:simulate": "node scripts/paybill-simulate.js",
    "worker": "node workers/index.js",
    "worker:dev": "nodemon workers/index.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:setup": "yarn db:migrate && yarn db:seed",
    "db:restore-xampp": "powershell -ExecutionPolicy Bypass -File scripts/restore-from-xampp.ps1"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^7.18.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "eslint": "^9.11.1",
    "nodemon": "^3.1.7"
  }
}
