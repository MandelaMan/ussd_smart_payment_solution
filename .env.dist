PORT=4000
NODE_ENV=development

# Optional: absolute path for error logs on production (default: <project>/logs)
# ERROR_LOG_DIR=/var/log/ussd_smart_payment_solution

# =============================================================================
# MySQL DATABASE CONNECTION — the app connects ONLY with these MYSQL_* vars
# (api/config/db.js). Do NOT put DB credentials in ADMIN_PASSWORD / etc. below.
#
# Local Docker:  host 127.0.0.1, port 3307, user root, db ussd_smart_payment_solution
# Staging:       host 127.0.0.1, port 3306, user ussd_app, db ussd_smart_payment_staging
# Production:    host 127.0.0.1, port 3306, dedicated user, live DB name
# =============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ussd_smart_payment_solution
MYSQL_CONNECTION_LIMIT=25

# --- Admin Auth (JWT / CORS — not MySQL) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
# Max concurrent admin device sessions per account (oldest revoked on new login)
MAX_ADMIN_SESSIONS=5
# Must match the browser host you use for Vite (cookies are host-specific:
# localhost and 127.0.0.1 are different sessions). Prefer http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173
# Production: ADMIN_ORIGIN=https://app.sulsolutions.biz
# Staging:    ADMIN_ORIGIN=https://staging-app.sulsolutions.biz
# Super Admin inbox — notified on every staff password-reset request.
# Staff still receive their own reset link when the account exists and is active.
ACCOUNT_RECOVERY_EMAIL=it@sulsolutions.biz

# Shared secret for USSD customer lookup endpoints (required in production)
# USSD_API_SECRET=generate-a-random-secret-here

# --- Test users (development) — yarn db:seed ---
# These are ADMIN UI login passwords (bcrypt into admin_users), NOT MySQL credentials.
# Login at http://localhost:5173/admin/login (or /admin when using built UI)

# Administrator — full access (cannot be deactivated)
ADMIN_NAME=Admin
ADMIN_EMAIL=it@sulsolutions.biz
ADMIN_PASSWORD=Admin@2026

# Customer support — manage customers, read-only pricing
SUPPORT_NAME=Support User
SUPPORT_EMAIL=support@sulsolutions.biz
SUPPORT_PASSWORD=Support@12345

# CFO — transactions, billing ops, reports
CFO_NAME=CFO User
CFO_EMAIL=cfo@sulsolutions.biz
CFO_PASSWORD=Cfo@12345

# CEO — reports, BI, customers & payments (read-only money view)
CEO_NAME=CEO User
CEO_EMAIL=ceo@sulsolutions.biz
CEO_PASSWORD=Ceo@12345

# Partner — read-only dashboard and customer list
PARTNER_NAME=Partner User
PARTNER_EMAIL=partner@sulsolutions.biz
PARTNER_PASSWORD=Partner@12345

ZOHO_CLIENT_ID=1000.KMU03SOEN1XTEZREMCQTD1LD6RZDDY
ZOHO_CLIENT_SECRET=0dd572327de79d4825462760814c3420072c01e33a
ZOHO_REFRESH_TOKEN=1000.bdadfacf07c074ca717fd2126dbd1847.f988f597a972bf739f5ccd1285ba1c5e
ZOHO_ORG_ID=892601228
ZOHO_BASE_URL=https://www.zohoapis.com/books/v3
ZOHO_AUTH_URL=https://accounts.zoho.com/oauth/v2/token
# Must match a payment mode configured in Zoho Books (Settings → Payments)
ZOHO_PAYMENT_MODE=Mobile Money
# Deposited To for M-Pesa customer payments (not Paystack Funds).
# Prefer the Zoho bank/chart-of-accounts ID; name lookup is the fallback.
# ZOHO_MPESA_ACCOUNT_ID=
ZOHO_MPESA_DEPOSIT_ACCOUNT_NAME=MPESA PAYBILL NO 4185091
# ZOHO_MPESA_PAYBILL=4185091
# Used when marking signup invoices paid via Direct Bank transfer
# ZOHO_BANK_PAYMENT_MODE=Bank Remittance
# Optional Paystack payment mode label if you create payments (reconcile uses existing Zoho payment mode)
# ZOHO_PAYSTACK_PAYMENT_MODE=Paystack
# Recurring and one-off invoices check these Zoho payment-option gateways (Paystack checkbox).
# ZOHO_RECURRING_PAYMENT_GATEWAYS=paystack
# M-Pesa amounts are VAT-inclusive — invoice rate must not have VAT added again (3900 stays 3900, not 4524)
ZOHO_INVOICE_TAX_INCLUSIVE=true
# Signup invoice email from this app (Zoho Books can still email if configured in Books)
ZOHO_SIGNUP_INVOICE_EMAIL_ENABLED=false
# Optional fallback only — prefer Settings → Communication → Invoice CC emails.
# ZOHO_INVOICE_CC_EMAILS=support@sulsolutions.biz,director@sulsolutions.biz,accounts@sulsolutions.biz,it@sulsolutions.biz
# Recurring profile is always created on new C2B customer signup (paid or unpaid).
# Kept for compatibility; no longer gates signup recurring creation.
ZOHO_RECURRING_ON_SIGNUP=true
# One-time DSTV decoder fee (KES) — added only on the first signup invoice for DSTV packages
ZOHO_DSTV_ONE_TIME_FEE=2900
# Optional: Zoho tax_id for VAT line (Settings → Taxes). Only needed if inclusive flag alone is not enough.
# ZOHO_VAT_TAX_ID=
# Secret for POST /api/public/zoho/webhook — configure Zoho Books workflow on Invoice Paid
# (zero Zoho API calls; extends TISP when customer pays directly in Zoho Books)
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOHO_WEBHOOK_SECRET=change-me-generate-a-random-webhook-secret

TOKEN_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
STK_PUSH_ENDPOINT=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_CONSUMER_SECRET=Oh7ROMA8HPdvmr45JwcTkB1a7fkr7zNDzm4VmN543PScqAX3B6AwMUbSxjPEOKZG
MPESA_CONSUMER_KEY=VCRFj1t6C10zs0qgjtqLusQAj12Zx0abzqBlWYhjlDh3o220
MPESA_PASS_KEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://b135-41-90-136-37.ngrok-free.app/api/payment/callback
# Set to true to charge the real subscription amount on STK push (admin upgrades always use live amount)
MPESA_STK_USE_LIVE_AMOUNT=false
MPESA_CONFIRMATION_URL=https://b135-41-90-136-37.ngrok-free.app/api/payment/confirmation
MPESA_VALIDATION_URL=https://b135-41-90-136-37.ngrok-free.app/api/payment/validation
# M-Pesa callback security — IP allowlist (Safaricom Daraja egress) and/or shared secret header
# MPESA_CALLBACK_IP_ALLOWLIST=196.201.214.200,196.201.214.206,196.201.213.217
# Send as header X-Mpesa-Callback-Secret on Daraja callbacks (optional in dev; recommended in production)
# MPESA_CALLBACK_SECRET=change-me-generate-a-random-secret

# TISP WebISPService — use HTTP (HTTPS fails TLS verification on this host)
TISP_CLIENT_STATUS_URL=http://daraja.teqworthsystems.com/starlynxservice/WebISPService.svc/ClientStatus
TISP_SET_CLIENT_URL=http://daraja.teqworthsystems.com/starlynxservice/WebISPService.svc/SetClientDetails
TISP_SET_PACKAGE_URL=http://daraja.teqworthsystems.com/starlynxservice/WebISPService.svc/SetPackageDetails
# TISP HTTP timeouts (ms) — quote uses the shorter TISP_QUOTE_TIMEOUT_MS
TISP_REQUEST_TIMEOUT_MS=15000
TISP_QUOTE_TIMEOUT_MS=5000
# ShortCode field for TISP SetClientDetails INSERT (must be 000000 per TISP API)
TISP_SHORTCODE=000000
# Standard TISP due date for create/update defaults (YYYY-MM-DD = 2 August 2026)
TISP_STANDARD_DUE_DATE=2026-08-02
ISP_PAYMENT_URL=http://daraja.teqworthsystems.com/starlynxservice/WebISPService.svc/SetISPPayment

# Optional OLT EMS HTTP timeout only (credentials + host live on each building)
OLT_EMS_TIMEOUT_MS=30000

# --- B2C transaction split payout ---
MPESA_B2C_ENDPOINT=https://sandbox.safaricom.co.ke/mpesa/b2c/v1/paymentrequest
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_PARTY_A=600000
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_TIMEOUT_URL=https://b135-41-90-136-37.ngrok-free.app/api/payment/b2c/timeout
MPESA_B2C_RESULT_URL=https://b135-41-90-136-37.ngrok-free.app/api/payment/b2c/result
MPESA_B2C_REMARKS=Revenue share payout
MPESA_B2C_OCCASION=Transaction split

# --- Xtream Codes streaming API (wwwdir/api.php on port 25461; admin UI is 25500) ---
XTREAM_BASE_URL=http://100.121.223.62:25461/
XTREAM_DEVELOPER_USERNAME=
XTREAM_DEVELOPER_PASSWORD=
XTREAM_SYNC_ENABLED=true
XTREAM_SYNC_INTERVAL_MS=86400000
XTREAM_REQUEST_TIMEOUT_MS=20000

# --- Billing reconciliation ---
RECONCILIATION_ZOHO_CONCURRENCY=3
# Customers shown on billing gaps before search (local data only; no Zoho API)
RECONCILIATION_BROWSE_BATCH=10
# Integration snapshots (Zoho contact/invoices/payments, TISP status) — hours before optional API refresh
INTEGRATION_SNAPSHOT_MAX_AGE_HOURS=168

# --- Background Sync (BullMQ + Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave empty if local Redis has no AUTH (avoids connection warnings/delays).
REDIS_PASSWORD=ussd_redis_pass
REDIS_DB=1
SYNC_ENABLED=true
SYNC_SCHEDULER_ENABLED=true
# Run workers inside API process (dev only; use yarn worker in production)
WORKER_INLINE=false
# --- Zoho API conservation (default: minimal) ---
# minimal = only contacts+invoices on schedule; webhooks + manual refresh for everything else
ZOHO_SYNC_MODE=minimal
ZOHO_SCHEDULED_MODULES=zoho-contacts,invoices
ZOHO_BACKGROUND_SYNC_ENABLED=true
ZOHO_INCREMENTAL_LOOKBACK_DAYS=7
# Max list API pages per background sync run (minimal default: 3 = up to 600 rows)
ZOHO_SYNC_MAX_PAGES=3
ZOHO_SYNC_INTERVAL_MS=3600000
SYNC_INTERVAL_MS=3600000
# Scheduled full per-customer Zoho scan — OFF by default (use manual sync if needed)
RECONCILIATION_FULL_ZOHO_SCHEDULED=false
RECONCILIATION_FULL_ZOHO_INTERVAL_MS=86400000
ZOHO_CONTACT_CACHE_TTL_MS=1800000
CUSTOMER_SYNC_INTERVAL_MS=900000
PAYMENT_SYNC_INTERVAL_MS=120000
# Quick reconciliation (MySQL only, no Zoho) every 15 min
RECONCILIATION_SYNC_INTERVAL_MS=900000
PRODUCTS_SYNC_INTERVAL_MS=3600000
API_TIMEOUT_MS=30000
API_CONCURRENCY=5
ZOHO_SYNC_CONCURRENCY=2
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
CACHE_TTL_SECONDS=300
# Per-customer Zoho cache for profile reads (defaults to CACHE_TTL_SECONDS)
CUSTOMER_CACHE_DURATION_SECONDS=300
WORKER_CONCURRENCY=2
SYNC_PAGE_SIZE=100
# Zoho Books daily API budget (https://www.zoho.com/books/api/v3/#introduction)
ZOHO_DAILY_API_LIMIT=10000
# Reserve calls for user actions (allocate payment, refresh customer, manual sync)
ZOHO_DAILY_API_RESERVE=1500
ZOHO_API_BUDGET_ENABLED=true
ZOHO_CALLS_PER_CUSTOMER_ESTIMATE=4
API_WARNING_THRESHOLD=7000
API_CRITICAL_THRESHOLD=8500
API_EMERGENCY_THRESHOLD=9500

# Zoho Mail — OAuth only (from address / name / account ID are in Settings → Communication)
ZOHO_MAIL_API_BASE=https://mail.zoho.com/api
# REQUIRED: refresh token with ZohoMail.messages.ALL,ZohoMail.accounts.READ
# node scripts/zoho-mail-oauth-exchange.js --url "PASTE_REDIRECT_URL"
# ZOHO_MAIL_REFRESH_TOKEN=
# ZOHO_MAIL_REDIRECT_URI=https://app.sulsolutions.biz/api
# Optional defaults used until saved in Settings UI:
# ZOHO_MAIL_FROM_ADDRESS=customersupport@sulsolutions.biz
# ZOHO_MAIL_FROM_NAME=Customer Support
# ZOHO_MAIL_ACCOUNT_ID=6499189000000008002

# WhatsApp Cloud API — configure in Settings → Communication (optional .env fallback)
# Public webhook URL to register in Meta: https://YOUR_HOST/api/public/whatsapp/webhook
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_CLICK_TO_CHAT_URL=
# WHATSAPP_WELCOME_MESSAGE=
# WHATSAPP_COMPLETE_MESSAGE=
# WHATSAPP_OUTBOUND_TEMPLATE=
# WHATSAPP_OUTBOUND_TEMPLATE_LANG=en

# --- PWA web push (optional). If omitted, VAPID keys are generated and stored in app_settings. ---
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@sulsolutions.biz

